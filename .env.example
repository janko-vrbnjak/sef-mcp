# Copy OUTSIDE this repo (e.g. ~/.config/sef-mcp/.env.demo) and run via:
#   op run --env-file ~/.config/sef-mcp/.env.demo -- node dist/src/index.js serve
SEF_ENV=demo
SEF_API_KEY="op://<Vault>/<SEF demo item>/credential"
SEF_MCP_PROFILE=/absolute/path/to/profile.json
SEF_MCP_DATA_DIR=/absolute/path/to/data-demo
# SEF_MCP_ATTACHMENTS_DIR=/absolute/path/to/attachments
# SEF_MCP_READ_ONLY=false
# SEF_MCP_ALLOW_PROD_WRITE=false   # only for SEF_ENV=prod, after a full demo cycle
